{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "gyeol-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "gyeol-docs",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "4173",
        "--bind",
        "127.0.0.1",
        "--directory",
        "team"
      ],
      "port": 4173
    },
    {
      "name": "gyeol-preview",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "preview",
        "--host",
        "127.0.0.1",
        "--port",
        "4174",
        "--strictPort"
      ],
      "port": 4174
    },
    {
      "name": "gyeol-lan",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "--host",
        "0.0.0.0",
        "--port",
        "5180",
        "--strictPort"
      ],
      "port": 5180
    }
  ]
}